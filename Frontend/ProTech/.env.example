# ProTech frontend (Vite). Copy to `.env` or `.env.local` for local overrides.

# Backend API base URL for fetch calls (e.g. crop + upload, player overview).
# Leave empty in local dev to use the Vite dev proxy: `/api` → `http://localhost:5000`
# (see vite.config.js). In production, set to your deployed API origin, e.g.
# VITE_API_URL=https://your-api.onrender.com
VITE_API_URL=
