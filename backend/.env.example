# Copy to .env for local dev only — set these in Render Dashboard for production.

PORT=5000

# Supabase (anon key is used by the React app; backend also needs URL + key below)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Service role: required for player_overview cache writes and for POST /api/athlete-photo
# (server-side cropped uploads to the athlete-images bucket). Get from Supabase → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional alias if you prefer not to prefix with VITE_ for server-only URL:
# SUPABASE_URL=https://xxxx.supabase.co

# LLM (Groq recommended)
GROQ_API_KEY=gsk_your_key_here
LLM_PROVIDER=groq

# Vercel frontend URL (for CORS) — no trailing slash
FRONTEND_URL=https://your-app.vercel.app
